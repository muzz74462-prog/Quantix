# Phase 1 (landing page) needs no environment variables.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets (apps/web/.env.local and your host's environment settings). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random string, 32+ characters, used to sign the user session cookie (e.g. `openssl rand -hex 32`).
USER_SESSION_SECRET=
# ADMIN_PASSWORD is no longer used: admins are rows in public.admin_users (see scripts/create-admin.mjs).
